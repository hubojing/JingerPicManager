# --- JingerPicManager specific ---

# Release artifacts (distributable bundle)
/output/

# Large third-party binaries: fetched separately, see README "从源码构建"
/assets/models/
/windows/third_party/
/windows/runner/*.dll
*.pdb
*.exp
*.lib
*.so

# Face pipeline debug tool: build output and decoded photo samples.
# IMPORTANT: samples may be copies of your own private photos - never commit.
/tools/face_probe/build/
/tools/face_probe/samples/
*.ppm
*.rgb

# Local runtime data (normally lives in %APPDATA%\jingerpicmanager, this is a
# safety net so an accidental export can never be committed)
*.sqlite
*.sqlite3
settings.json
/thumbnails_backup/

# Workspace / assistant data
.workbuddy/

# Exceptions to above rules.
